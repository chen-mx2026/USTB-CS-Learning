#include <iostream>
using namespace std;

int main() {
    int x;
    cin >> x;

    // 1. 按照题目要求，大于等于6位（100000及以上）输出错误信息
    if (x >= 100000) {
        cout << "a bad number" << endl;
    }
    // 2. 五位数 (10000 - 99999)
    else if (x >= 10000) {
        cout << "10000:" << x / 10000 
             << " 1000:" << (x / 1000) % 10 
             << " 100:" << (x / 100) % 10 
             << " 10:" << (x / 10) % 10 
             << " 1:" << x % 10 << endl;
    }
    // 3. 四位数 (1000 - 9999)
    else if (x >= 1000) {
        cout << "1000:" << x / 1000 
             << " 100:" << (x / 100) % 10 
             << " 10:" << (x / 10) % 10 
             << " 1:" << x % 10 << endl;
    }
    // 4. 三位数 (100 - 999)
    else if (x >= 100) {
        cout << "100:" << x / 100 
             << " 10:" << (x / 10) % 10 
             << " 1:" << x % 10 << endl;
    }
    // 5. 二位数 (10 - 99) -> 匹配你的测试数据1
    else if (x >= 10) {
        cout << "10:" << x / 10 
             << " 1:" << x % 10 << endl;
    }
    // 6. 一位数 (0 - 9)
    else {
        cout << "1:" << x << endl;
    }

    return 0;
}
