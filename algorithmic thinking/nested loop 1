#include <iostream>
using namespace std;

int main()
{ // 计算无重复的三位整数的个数

    int m;
    cin >> m;
    int count = 0;

    for (int i = 1; i <= m; i++)
    {
        for (int j = 0; j <= m; j++)
        {
            for (int k = 0; k <= m; k++)
            {
                if ((k % 2 == 0) && (i != j && i != k && k != j))
                {
                    count++;
                }
            }
        }
    }
    cout << count << endl;

    return 0;
}
