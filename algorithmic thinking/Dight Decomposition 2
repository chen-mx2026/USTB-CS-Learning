#include <iostream>
#include <cmath>
using namespace std;

int main()
{

    int n, n1 = 0, n2;
    cin >> n;
    n2 = n;

    if (!(100000 <=n &&n < 1000000))
    {
        cout << "输入错误，退出程序。" << endl;
    }
    else
    {
        for (int i = 1; i <= 6; i++)
        {
            int temp = n % 10;
            n /= 10;
            temp += 7;
            temp %= 10;
            n1 += temp * pow(10, 6-i);
        }
        cout <<"加密："<< n1 << endl
             <<"解密："<< n2 << endl;
    }

    return 0;
}
